{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foconn",
  "version": "0.1.0",
  "identifier": "com.fofo.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true, 
    "windows": [
      {
        "title": "Foconn",
        "label": "main",
        "width": 1280,
        "height": 900,
        "center": true,
        "visible": false,
        "resizable": true,
        "transparent": true,
        "backgroundColor": [13, 17, 23, 255]
      },
      {
        "title": "Loading",
        "label": "splashscreen",
        "width": 360,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "url": "/splashscreen.html",
        "visible": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}